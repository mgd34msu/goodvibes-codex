{
  "description": "GoodVibes Codex lifecycle hooks. Hooks are fail-open guardrails and bounded telemetry writers; MCP launchers handle automatic dependency repair without mutating the plugin cache.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/session-start.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\session-start.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking GoodVibes session context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/commit-guard.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\commit-guard.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking for GoodVibes credential files"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/pre-compact.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\pre-compact.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/subagent-start.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\subagent-start.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/subagent-stop.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\subagent-stop.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/stop.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\stop.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
